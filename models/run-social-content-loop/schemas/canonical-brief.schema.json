{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growth-lab/canonical-brief.schema.json",
  "title": "Growth Lab canonical social content brief",
  "type": "object",
  "required": ["schema_version", "brief_id", "status", "research_plan_sha256", "product_facts", "audience", "objective", "core_message", "insights", "source_boundaries", "target_directions", "content_governance"],
  "properties": {
    "schema_version": {"const": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "status": {"const": "approved"},
    "research_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "product_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "evidence_files"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "evidence_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "audience": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "core_message": {"type": "string", "minLength": 1},
    "insights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["insight", "source_ids"],
        "properties": {
          "insight": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "source_boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "target_directions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["platform", "message_job", "learning_scope"],
        "properties": {
          "platform": {"enum": ["x", "xiaohongshu", "instagram", "tiktok", "email"]},
          "message_job": {"type": "string", "minLength": 1},
          "primary_reference_id": {"type": ["string", "null"]},
          "learning_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["topic", "structure", "tone", "visual", "format"]}
        }
        },
        "additionalProperties": false
      }
    },
    "content_governance": {"type": "object"}
  },
  "additionalProperties": false
}
