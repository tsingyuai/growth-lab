{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growth-lab/asset-evidence-ledger.schema.json",
  "title": "Growth Lab script asset evidence ledger",
  "type": "object",
  "required": ["schema_version", "script_file", "script_sha256", "shots"],
  "properties": {
    "schema_version": {"const": 1},
    "script_file": {"type": "string", "minLength": 1},
    "script_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "asset_file", "asset_sha256", "status", "requirements"],
        "properties": {
          "shot_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"},
          "asset_file": {"type": "string", "minLength": 1},
          "asset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "status": {"const": "pass"},
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["requirement_id", "status", "evidence_file", "evidence_timestamp_seconds", "observed_hold_seconds", "observed_state"],
              "properties": {
                "requirement_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"},
                "status": {"const": "pass"},
                "evidence_file": {"type": "string", "minLength": 1},
                "evidence_timestamp_seconds": {"type": "number", "minimum": 0, "maximum": 300},
                "observed_hold_seconds": {"type": "number", "minimum": 0, "maximum": 30},
                "observed_state": {"type": "string", "minLength": 1, "maxLength": 500}
              },
              "additionalProperties": false
            }
          },
          "caption_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["group_id", "segment_id", "status", "lane", "audio_start_seconds", "caption_start_seconds"],
              "properties": {
                "group_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"},
                "segment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"},
                "status": {"const": "pass"},
                "lane": {"enum": ["left", "center", "right"]},
                "audio_start_seconds": {"type": "number", "minimum": 0, "maximum": 300},
                "caption_start_seconds": {"type": "number", "minimum": 0, "maximum": 300}
              },
              "additionalProperties": false
            }
          },
          "caption_group_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["group_id", "status", "audio_end_seconds", "caption_exit_seconds"],
              "properties": {
                "group_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"},
                "status": {"const": "pass"},
                "audio_end_seconds": {"type": "number", "minimum": 0, "maximum": 300},
                "caption_exit_seconds": {"type": "number", "minimum": 0, "maximum": 300}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
