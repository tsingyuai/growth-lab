# 微信公众号远程发布服务配置模板
# ─────────────────────────────────────────────────────────────
# 使用位置:
#   <部署目录>/.env
#
# 这份 .env 只给远程发布服务容器使用,不要和 Growth Lab
# 项目根目录 .env.local 混用。容器只读挂载它,部署流程不上传或覆盖它。
# ─────────────────────────────────────────────────────────────

# ============ 微信公众号凭据 ============

# 微信公众平台后台获取。服务器公网 IP 必须先加入 API IP 白名单。
WECHAT_MP_APP_ID="wx..."
WECHAT_MP_APP_SECRET="..."

# 账号标签和默认文章字段。
WECHAT_MP_ACCOUNT_LABEL=""
WECHAT_MP_DEFAULT_AUTHOR=""
WECHAT_MP_DEFAULT_SOURCE_URL=""

# ============ 发布安全闸 ============

# 默认 false = 远程服务只能创建草稿。
# 真正发布还需要单篇 wechat.yml publish.approved=true,
# 且调用发布接口时显式传 confirm_publish=true。
WECHAT_ENABLE_AUTO_PUBLISH=false

# 远程服务内部调用 token。本地客户端也要配置同一个值。
# 生成方式:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WECHAT_PUBLISH_SERVICE_TOKEN="replace-with-long-random-token"

# ============ 容器运行配置 ============

WECHAT_PUBLISH_HOST="0.0.0.0"
WECHAT_PUBLISH_PORT=8080
WECHAT_PUBLISH_WORKDIR="/data/wechat-posts"
WECHAT_TOKEN_CACHE_PATH="/data/wechat-token/access-token.json"

# 默认评论设置:0 关闭 / 1 开启。
WECHAT_OPEN_COMMENT=0
WECHAT_ONLY_FANS_CAN_COMMENT=0
