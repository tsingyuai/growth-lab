# Bing Webmaster API：读取关键词与站点搜索表现
BING_WEBMASTER_API_KEY=

# IndexNow：提交已上线或已更新的页面 URL
INDEXNOW_KEY=
SITE_URL=https://example.com
# 可选；默认值为 ${SITE_URL}/${INDEXNOW_KEY}.txt
INDEXNOW_KEY_LOCATION=

# 可选：仓库内 generate-image Client 使用
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GOOGLE_GEMINI_BASE_URL=

# 微信公众号：二选一。本机直连需把出口 IP 加入公众号后台 API IP 白名单；
# 远程服务模式下 AppSecret 只放服务器，模板见 executors/wechat-mp-publish/deploy/server.env.example
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_PUBLISH_SERVICE_URL=
WECHAT_PUBLISH_SERVICE_TOKEN=
# 可选：wechat.yml 留空时的默认作者与“阅读原文”链接
WECHAT_MP_DEFAULT_AUTHOR=
WECHAT_MP_DEFAULT_SOURCE_URL=
# 默认 false = 只允许创建草稿；真正发布还需 wechat.yml publish.approved=true 与 --confirm-publish
WECHAT_ENABLE_AUTO_PUBLISH=false

# 环境配置由 models/onboard-growth-lab/SKILL.md 通过自然语言统一审计。
# 第三方 client 和认证 profile 均放在仓库外；可按本机情况覆盖。
GROWTHLAB_CLIENT_ROOT="$HOME/.growth-lab/clients"
MEDIACRAWLER_DIR="$HOME/.growth-lab/clients/MediaCrawler"
DEFAULT_TIME_WINDOW=30d
DEFAULT_MIN_LIKES=1000
DEFAULT_SAMPLE_LIMIT=30
OPENAI_IMAGE_MODEL="gpt-image-2"
