# 海外平台网络前置配置；auto 先测直连，再尝试用户已有的显式/系统代理。
# 仅使用用户有权使用的固定代理，不自动轮换或规避平台控制。
SOCIAL_PROXY_MODE=auto
# explicit 或 auto 回退时使用；支持 http(s)://、socks4:// 或 socks5://，凭据不得发到对话中
SOCIAL_PROXY_URL=
# 本机 MCP、adapter 与浏览器调试端口必须绕过代理
SOCIAL_PROXY_BYPASS=127.0.0.1,localhost,::1

# 浏览器共享选择：auto 优先 Chrome，未安装时自动使用 Edge。
# system 代理模式下浏览器继承 Windows 系统代理/PAC/按域名规则。
SOCIAL_BROWSER_FAMILY=auto
# SOCIAL_BROWSER_PATH="C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe"

# Bing Webmaster API：读取关键词与站点搜索表现
BING_WEBMASTER_API_KEY=

# IndexNow：提交已上线或已更新的页面 URL
INDEXNOW_KEY=
SITE_URL=https://example.com
# 可选；默认值为 ${SITE_URL}/${INDEXNOW_KEY}.txt
INDEXNOW_KEY_LOCATION=

# 可选：AI 生图。OpenAI 或 Gemini 配置一组即可；不生图时可全部留空
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL="gpt-image-2"
# 可选：X 外文内容翻译；仅在显式使用 --translate-zh 时调用
OPENAI_TEXT_MODEL="gpt-4.1-mini"
GEMINI_API_KEY=
GOOGLE_GEMINI_BASE_URL=

# 小红书 browser-first 只读采集；二进制和登录态必须放在仓库外
XHS_MCP_ENDPOINT=http://127.0.0.1:18063
XHS_MCP_TIMEOUT_SECONDS=60
XHS_MCP_BINARY=
XHS_MCP_LOGIN_BINARY=
XHS_MCP_COOKIES_PATH=
XHS_REQUEST_INTERVAL_MS=2000
XHS_RATE_LIMIT_PER_MIN=20
XHS_BACKOFF_SECONDS=300
DEFAULT_SAMPLE_LIMIT=25

# X browser-first 只读采集；代理复用上方 SOCIAL_PROXY_*，profile 与登录态放在仓库外
X_BROWSER_PYTHON="%USERPROFILE%\.growth-lab\clients\x-browser-venv\Scripts\python.exe"
X_BROWSER_PROFILE_DIR="%LOCALAPPDATA%\growth-lab\x\browser-profile"
X_BROWSER_CDP_PORT=19222
X_CONNECTIVITY_URL=https://x.com/robots.txt
# X 官方发布 API；必须是目标账号授权的 user access token，不用于 browser-first 采集
X_USER_ACCESS_TOKEN=

# 微信公众号官方 API；仅由微信 Client 读取，草稿和正式发布分别授权
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 可选视频生成器；依赖安装在仓库外，不影响图文流程
VIDEO_RENDERER_PYTHON="%USERPROFILE%\.growth-lab\clients\social-video-venv\Scripts\python.exe"
# 可选；为空时视频 venv 使用 imageio-ffmpeg 的外部二进制
VIDEO_FFMPEG_PATH=
# 可选本地 AI 配音；模型与缓存保留在仓库外
SOCIAL_TTS_PYTHON="%USERPROFILE%\.growth-lab\clients\social-tts-venv\Scripts\python.exe"

# 可选 Seedance/火山方舟生成式 B-roll；只有用户逐次批准后才创建付费任务
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 填写用户账号中已开通的视频生成模型 Endpoint ID，不在代码中写死模型版本
SEEDANCE_MODEL_ENDPOINT=

# TikTok 官方 Display API；只读检查用户已授权账号
TIKTOK_ACCESS_TOKEN=
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
# TikTok browser-first 内容研究 adapter（当前需另行批准运行时）
TIKTOK_MCP_ENDPOINT=http://127.0.0.1:18064

# Meta 官方 Instagram Graph API；只读检查用户已授权账号
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
# 可选；按 Meta App 当前使用的 Graph API 版本填写，例如 vXX.X
INSTAGRAM_GRAPH_API_VERSION=
INSTAGRAM_USER_ID=me
INSTAGRAM_PROFILE_FIELDS=user_id,username
# Instagram browser-first 内容研究 adapter（当前需另行批准运行时）
INSTAGRAM_MCP_ENDPOINT=http://127.0.0.1:18065

# 其他媒体平台仍可使用外部 MediaCrawler；小红书和 X 不经过它
GROWTHLAB_CLIENT_ROOT="$HOME/.growth-lab/clients"
MEDIACRAWLER_DIR="$HOME/.growth-lab/clients/MediaCrawler"
DEFAULT_TIME_WINDOW=30d
DEFAULT_MIN_LIKES=1000
