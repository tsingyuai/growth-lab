# Bing Webmaster API：读取关键词与站点搜索表现
BING_WEBMASTER_API_KEY=

# IndexNow：提交已上线或已更新的页面 URL
INDEXNOW_KEY=
SITE_URL=https://example.com
# 可选；默认值为 ${SITE_URL}/${INDEXNOW_KEY}.txt
INDEXNOW_KEY_LOCATION=

# 可选：仓库内 generate-image Client 使用
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GOOGLE_GEMINI_BASE_URL=

# 环境配置由 models/onboard-growth-lab/SKILL.md 通过自然语言统一审计。
# 第三方 client 和认证 profile 均放在仓库外；可按本机情况覆盖。
GROWTHLAB_CLIENT_ROOT="$HOME/.growth-lab/clients"
MEDIACRAWLER_DIR="$HOME/.growth-lab/clients/MediaCrawler"
DEFAULT_TIME_WINDOW=30d
DEFAULT_MIN_LIKES=1000
DEFAULT_SAMPLE_LIMIT=30
OPENAI_IMAGE_MODEL="gpt-image-2"
