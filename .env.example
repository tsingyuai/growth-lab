# Bing Webmaster API：读取关键词与站点搜索表现
BING_WEBMASTER_API_KEY=

# IndexNow：提交已上线或已更新的页面 URL
INDEXNOW_KEY=
SITE_URL=https://example.com
# 可选；默认值为 ${SITE_URL}/${INDEXNOW_KEY}.txt
INDEXNOW_KEY_LOCATION=

# 可选：AI 生图。OpenAI 或 Gemini 配置一组即可；不生图时可全部留空
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL="gpt-image-2"
GEMINI_API_KEY=
GOOGLE_GEMINI_BASE_URL=

# 小红书 browser-first 只读采集；二进制和登录态必须放在仓库外
XHS_MCP_ENDPOINT=http://127.0.0.1:18063
XHS_MCP_TIMEOUT_SECONDS=60
XHS_MCP_BINARY=
XHS_MCP_LOGIN_BINARY=
XHS_MCP_COOKIES_PATH=
XHS_REQUEST_INTERVAL_MS=2000
XHS_RATE_LIMIT_PER_MIN=20
XHS_BACKOFF_SECONDS=300
DEFAULT_SAMPLE_LIMIT=25

# 其他媒体平台仍可使用外部 MediaCrawler；小红书不再经过它
GROWTHLAB_CLIENT_ROOT="$HOME/.growth-lab/clients"
MEDIACRAWLER_DIR="$HOME/.growth-lab/clients/MediaCrawler"
DEFAULT_TIME_WINDOW=30d
DEFAULT_MIN_LIKES=1000
